{
  "$defs": {
    "claim": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "minimum": 1,
          "type": "integer"
        },
        "collector_kind": {
          "minLength": 1,
          "type": "string"
        },
        "component_id": {
          "minLength": 1,
          "type": "string"
        },
        "config_handle": {
          "minLength": 1,
          "type": "string"
        },
        "deadline": {
          "format": "date-time",
          "type": "string"
        },
        "fencing_token": {
          "minLength": 1,
          "type": "string"
        },
        "generation_id": {
          "minLength": 1,
          "type": "string"
        },
        "instance_id": {
          "minLength": 1,
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "source_run_id": {
          "minLength": 1,
          "type": "string"
        },
        "source_system": {
          "minLength": 1,
          "type": "string"
        },
        "work_item_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "instance_id",
        "collector_kind",
        "source_system",
        "scope",
        "source_run_id",
        "generation_id",
        "work_item_id",
        "fencing_token",
        "attempt",
        "deadline",
        "config_handle"
      ],
      "type": "object"
    },
    "coverage_reason": {
      "enum": [
        "not_observed",
        "permission_denied",
        "throttled",
        "source_error",
        "unsupported",
        "capacity_exceeded"
      ]
    },
    "coverage_report": {
      "additionalProperties": false,
      "properties": {
        "resources": {
          "items": {
            "$ref": "#/$defs/resource_observation"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "root": {
          "$ref": "#/$defs/root_coverage"
        },
        "sets": {
          "items": {
            "$ref": "#/$defs/set_coverage"
          },
          "maxItems": 20000,
          "type": "array"
        }
      },
      "required": [
        "root",
        "resources",
        "sets"
      ],
      "type": "object"
    },
    "fact": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "minLength": 1,
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "ownership": {
          "$ref": "#/$defs/ownership_set"
        },
        "payload": {
          "type": "object"
        },
        "redactions": {
          "items": {
            "$ref": "#/$defs/redaction"
          },
          "type": "array"
        },
        "schema_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        },
        "source_confidence": {
          "enum": [
            "observed",
            "reported",
            "inferred",
            "derived"
          ]
        },
        "source_ref": {
          "$ref": "#/$defs/source_ref"
        },
        "stable_key": {
          "minLength": 1,
          "type": "string"
        },
        "tombstone": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "schema_version",
        "stable_key",
        "source_confidence",
        "observed_at",
        "source_ref",
        "payload",
        "ownership"
      ],
      "type": "object"
    },
    "generation": {
      "additionalProperties": false,
      "properties": {
        "freshness_hint": {
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "trusted_deletion": {
          "const": false
        }
      },
      "required": [
        "id",
        "observed_at"
      ],
      "type": "object"
    },
    "ownership_set": {
      "additionalProperties": false,
      "properties": {
        "collection": {
          "enum": [
            "aws_ec2_core",
            "aws_ec2_security_group_rules",
            "aws_lambda_function",
            "aws_lambda_event_source_mappings",
            "aws_eks_cluster",
            "aws_eks_iam_enrichment",
            "aws_s3_bucket",
            "aws_s3_bucket_encryption"
          ]
        },
        "resource_id": {
          "minLength": 1,
          "type": "string"
        },
        "resource_kind": {
          "enum": [
            "aws_ec2_resource",
            "aws_ec2_security_group",
            "aws_lambda_function",
            "aws_eks_cluster",
            "aws_s3_bucket"
          ]
        }
      },
      "required": [
        "collection",
        "resource_kind",
        "resource_id"
      ],
      "type": "object"
    },
    "redaction": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "field",
        "reason"
      ],
      "type": "object"
    },
    "resource_observation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "aws_ec2_resource",
            "aws_ec2_security_group",
            "aws_lambda_function",
            "aws_eks_cluster",
            "aws_s3_bucket"
          ]
        },
        "reason": {
          "$ref": "#/$defs/coverage_reason"
        },
        "state": {
          "enum": [
            "present",
            "absent",
            "incomplete"
          ]
        }
      },
      "required": [
        "kind",
        "id",
        "state"
      ],
      "type": "object"
    },
    "root_coverage": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "$ref": "#/$defs/coverage_reason"
        },
        "root": {
          "enum": [
            "aws_ec2_resources",
            "aws_lambda_functions",
            "aws_eks_clusters",
            "aws_s3_buckets",
            "aws_required_service"
          ]
        },
        "state": {
          "enum": [
            "complete",
            "incomplete"
          ]
        }
      },
      "required": [
        "root",
        "state"
      ],
      "type": "object"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "set_coverage": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "$ref": "#/$defs/coverage_reason"
        },
        "set": {
          "$ref": "#/$defs/ownership_set"
        },
        "state": {
          "enum": [
            "complete",
            "incomplete"
          ]
        }
      },
      "required": [
        "set",
        "state"
      ],
      "type": "object"
    },
    "source_ref": {
      "additionalProperties": false,
      "properties": {
        "fact_key": {
          "minLength": 1,
          "type": "string"
        },
        "generation_id": {
          "minLength": 1,
          "type": "string"
        },
        "record_id": {
          "minLength": 1,
          "type": "string"
        },
        "scope_id": {
          "minLength": 1,
          "type": "string"
        },
        "source_system": {
          "minLength": 1,
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source_system",
        "scope_id",
        "generation_id",
        "fact_key",
        "uri",
        "record_id"
      ],
      "type": "object"
    },
    "status": {
      "additionalProperties": false,
      "properties": {
        "class": {
          "enum": [
            "progress",
            "warning",
            "failure",
            "complete"
          ]
        },
        "fact_count": {
          "minimum": 0,
          "type": "integer"
        },
        "failure_class": {
          "type": "string"
        },
        "partial": {
          "type": "boolean"
        },
        "retry_after_seconds": {
          "minimum": 0,
          "type": "integer"
        },
        "source_latency_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "warning_count": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "class"
      ],
      "type": "object"
    }
  },
  "$id": "https://eshu.dev/schemas/collector-sdk/v1alpha3/result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "not": {
          "required": [
            "coverage"
          ]
        }
      },
      "if": {
        "properties": {
          "state": {
            "enum": [
              "complete",
              "partial"
            ]
          }
        }
      },
      "then": {
        "required": [
          "coverage"
        ]
      }
    }
  ],
  "properties": {
    "claim": {
      "$ref": "#/$defs/claim"
    },
    "coverage": {
      "$ref": "#/$defs/coverage_report"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/fact"
      },
      "type": "array"
    },
    "generation": {
      "$ref": "#/$defs/generation"
    },
    "protocol_version": {
      "const": "collector-sdk/v1alpha3"
    },
    "state": {
      "enum": [
        "complete",
        "unchanged",
        "partial",
        "retryable",
        "terminal"
      ]
    },
    "statuses": {
      "items": {
        "$ref": "#/$defs/status"
      },
      "type": "array"
    }
  },
  "required": [
    "protocol_version",
    "state",
    "claim",
    "generation"
  ],
  "title": "Eshu Collector SDK Result",
  "type": "object"
}
